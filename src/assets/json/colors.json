  "families": [
    {
      "id": "jacaranda",
      "name": "Jacaranda",
      "role": "Primario",
      "description": "El violeta de las calles de la Ciudad de México en marzo. Es el color de marca: botones principales, enlaces y foco.",
      "use": [
        "Acciones principales",
        "Enlaces",
        "Anillos de foco"
      ],
      "keywords": "morado violeta purpura lila purple violet"
    },
    {
      "id": "cempasuchil",
      "name": "Cempasúchil",
      "role": "Acento",
      "description": "El naranja dorado de la flor de muertos. Se usa poco y a propósito: una llamada de atención por pantalla.",
      "use": [
        "Destacados",
        "Advertencias",
        "Estrellas y logros"
      ],
      "keywords": "naranja amarillo dorado orange yellow gold"
    },
    {
      "id": "rosa",
      "name": "Rosa mexicano",
      "role": "Acento vivo",
      "description": "Rosa intenso, el más eufórico de la paleta. Funciona en degradados junto al jacaranda.",
      "use": [
        "Degradados",
        "Ilustración",
        "Énfasis puntual"
      ],
      "keywords": "rosa fucsia magenta pink"
    },
    {
      "id": "agave",
      "name": "Agave",
      "role": "Éxito",
      "description": "Verde azulado de campo de agave. Confirma que algo salió bien.",
      "use": [
        "Confirmaciones",
        "Estados correctos",
        "Tendencias al alza"
      ],
      "keywords": "verde green teal"
    },
    {
      "id": "cielo",
      "name": "Cielo",
      "role": "Información",
      "description": "Azul de cielo despejado en el Altiplano. Informa sin alarmar.",
      "use": [
        "Avisos",
        "Ayuda",
        "Enlaces secundarios"
      ],
      "keywords": "azul celeste blue"
    },
    {
      "id": "granada",
      "name": "Granada",
      "role": "Peligro",
      "description": "Rojo profundo de granada abierta. Reservado para errores y acciones destructivas.",
      "use": [
        "Errores",
        "Eliminar",
        "Tendencias a la baja"
      ],
      "keywords": "rojo red carmesi"
    },
    {
      "id": "piedra",
      "name": "Piedra",
      "role": "Neutro",
      "description": "Grises con un toque de violeta, como la piedra volcánica. Sostienen texto, bordes y superficies.",
      "use": [
        "Texto",
        "Bordes",
        "Fondos"
      ],
      "keywords": "gris neutro gray grey"
    }
  ],
